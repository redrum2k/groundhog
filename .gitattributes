# Pinned payment interface/source hashes are hashes of these exact LF bytes.
backend/app/payments/abi/*.json text eol=lf
backend/app/payments/abi/source/*.sol text eol=lf
# Generated text is compared byte-for-byte by the drift check.
frontend/lib/*.generated.ts text eol=lf
frontend/api.generated.ts text eol=lf
docs/openapi.json text eol=lf
# Preserve the published qualification bundle hashes on Windows checkouts.
docs/evidence/aggregate-qualification*.json text eol=lf
# The published ROI dashboard is a hashed export of the preserved local run.
docs/evidence/roi-dashboard.html text eol=lf
