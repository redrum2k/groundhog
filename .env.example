# Local mock API. Copy to an ignored .env; the app does not load it automatically.
PAYMENT_ADAPTER=mock
ORDER_DB_PATH=artifacts/orders.sqlite3
MOCK_PAYMENT_DB_PATH=artifacts/legacy-mock-payments.sqlite3
ARTIFACT_ROOT=artifacts
INTERNAL_API_TOKEN=
REVIEWER_API_TOKEN=
ENABLE_PAID_MODELS=false
ANTHROPIC_API_KEY=
CLAUDE_MODEL=

# Implemented opt-in Base transport; no observed live testnet receipts.
# base_sepolia runs read-only preflight at startup; broadcast remains disabled here.
BASE_SEPOLIA_RPC_URL=
BASE_CHAIN_ID=84532
BASE_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
BASE_ESCROW_ADDRESS=0xf96815976523E00e65Be8f34cA5e64b4f41EB19c
BASE_ERC3009_COLLECTOR_ADDRESS=0x8612dfdc421f80336cd14E8EF9cb1E765dB5ab88
BASE_OPERATOR_ADDRESS=
BASE_OPERATOR_PRIVATE_KEY=
BASE_PROVIDER_ADDRESS=
SPIKE_BUYER_PRIVATE_KEY=
PAYMENT_CONFIRMATIONS=2
BASE_MAX_GAS=1000000
BASE_MAX_FEE_PER_GAS=10000000000
ENABLE_TESTNET_BROADCAST=false
# Isolated lab only. Catalog journal shares ORDER_DB_PATH for atomic bookings.
PAYMENT_JOURNAL_PATH=artifacts/payment-journal.sqlite3

# Same-origin runs bridge, local trusted demo only. Never NEXT_PUBLIC.
BROKER_LOCAL_DEMO=0
# BACKEND_URL=http://127.0.0.1:8016
# INTERNAL_API_TOKEN and REVIEWER_API_TOKEN above must differ.

# Password-protected hosted aggregate demo (frontend only; server-side).
# See docs/RAILWAY.md. Keep backend private; do not enable controlled_local learning.
BROKER_HOSTED_DEMO=0
APP_ORIGIN=
DEMO_USERNAME=demo
DEMO_PASSWORD=
